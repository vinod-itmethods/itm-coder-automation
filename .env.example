# ONEdevops Automation - Environment Variables
# Copy this file to .env and fill in values
# NEVER commit .env to git

# AWS
AWS_REGION=us-east-1

# Secrets Manager prefix (secrets stored as onedevops/*)
SECRETS_PREFIX=onedevops

# Orchestrator Lambda name (set by SAM, used by webhook for async invoke)
ORCHESTRATOR_FUNCTION_NAME=onedevops-orchestrator-stage

# DynamoDB table for traces
TRACES_TABLE_NAME=onedevops-traces-stage

# Coder (leave blank until provided)
CODER_BASE_URL=
CODER_ORG_ID=default

# Bedrock
BEDROCK_MODEL_ID=us.anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_REGION=us-east-1

# Logging
LOG_LEVEL=info
